{
  "name": "the-mechanical-brush",
  "productName": "The Mechanical Brush",
  "version": "0.4.1",
  "description": "המכחול המכני — local, layer-based, AI-assisted image editor",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Nimrod Pesach Saunders",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/golden.mjs",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "konva": "^9.3.20",
    "openai": "^4.77.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "use-image": "^1.1.1",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource/david-libre": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.65.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.mechanicalbrush.app",
    "productName": "The Mechanical Brush",
    "afterPack": "scripts/adhoc-sign.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/splash.png",
        "to": "splash.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": "mbrush",
        "name": "Mechanical Brush Project",
        "description": "פרויקט המכחול המכני",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
